# ==============================================================================
# SHRIRAMWAR OPTICALS - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
#
# IMPORTANT SECURITY RULES:
# 1. ONLY safe "Publishable / Anon" keys should be prefixed with VITE_ and placed here.
# 2. NEVER paste your "service_role" secret key into this file or any frontend code!
#    The service_role key bypasses Row Level Security (RLS) and is meant ONLY for secure backend servers.
# 3. If you have not created your Supabase project yet, the app works seamlessly in DEMO/OFFLINE mode.
# ==============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
# Found in Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (Safe for frontend use with RLS enabled)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon public
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Optional: Set to 'true' to force offline demo mock mode even if Supabase keys are configured
VITE_ENABLE_DEMO_DATA=true
